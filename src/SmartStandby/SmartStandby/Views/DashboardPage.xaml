<Page
    x:Class="SmartStandby.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SmartStandby.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SmartStandby.Converters"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="24,32,24,24">
            <TextBlock Text="{StaticResource NavDashboard}" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="System status and controls" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.6"/>
        </StackPanel>

        <!-- Status Card -->
        <Grid Grid.Row="1" Margin="24,0,24,24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{StaticResource WakeHealthHeader}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                    <TextBlock Text="{Binding HealthStatus}" Foreground="{Binding HealthColor}" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
                <TextBlock Text="{Binding HealthMessage}" FontSize="12" Opacity="0.8" FontStyle="Italic"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{StaticResource ButtonSmartSleep}" Style="{StaticResource AccentButtonStyle}" Command="{Binding SmartSleepCommand}" VerticalAlignment="Center" />
        </Grid>

        <!-- Chart -->
        <Grid Grid.Row="2" Margin="24,0,24,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Sleep Duration (Last 7 Days)" FontWeight="SemiBold" Margin="0,0,0,16"/>
            
            <ItemsControl Grid.Row="1" ItemsSource="{Binding ChartData}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="16"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel VerticalAlignment="Bottom" Spacing="8">
                            <Rectangle Width="24" Height="{Binding Height}" Fill="{ThemeResource AccentFillColorDefaultBrush}" RadiusX="4" RadiusY="4">
                                <ToolTipService.ToolTip>
                                    <TextBlock Text="{Binding Tooltip}"/>
                                </ToolTipService.ToolTip>
                            </Rectangle>
                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="11" Opacity="0.7"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Session History -->
        <TextBlock Text="{StaticResource RecentSessionsHeader}" Grid.Row="3" Margin="24,0,24,10" Style="{StaticResource SubtitleTextBlockStyle}"/>
        <ListView Grid.Row="4" Margin="24,0,24,24" ItemsSource="{Binding RecentSessions}" 
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="8">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Symbol="Clock" Margin="0,0,16,0" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SleepTime, StringFormat='{}{0:MM/dd HH:mm}'}" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding HealthMessage}" FontSize="12" Opacity="0.7"/>
                                <TextBlock Text="{Binding WakeSource, StringFormat='· Wake: {0}'}" FontSize="12" Opacity="0.5"
                                           Visibility="{Binding WakeSource, Converter={StaticResource StringVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding DrainRate, StringFormat='{}{0:F1}%/h'}" 
                                           Foreground="{Binding DrainRate, Converter={StaticResource DrainRateColorConverter}}" 
                                           FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding DurationMinutes, StringFormat='{}{0:F1} min'}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding BatteryStart, StringFormat='{}Batt: {0}%'}" HorizontalAlignment="Right" FontSize="12" Opacity="0.7"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty State -->
        <StackPanel Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    Visibility="{Binding RecentSessions.Count, Converter={StaticResource InverseVisibilityConverter}, FallbackValue=Visible}">
            <SymbolIcon Symbol="History" RenderTransformOrigin="0.5,0.5" Scale="2.0,2.0" Opacity="0.2"/>
            <TextBlock Text="{StaticResource NoSessionsMessage}" Opacity="0.4" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Blockers Section -->
        <StackPanel Grid.Row="5" Margin="24,0,24,0" Spacing="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Sleep Blockers" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Command="{Binding RefreshBlockersCommand}" Content="Scan" Width="80"/>
            </Grid>

            <!-- Blocker list (visible when blockers exist) -->
            <ListView ItemsSource="{Binding Blockers}" MaxHeight="160"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      CornerRadius="8" Padding="8"
                      Visibility="{Binding Blockers.Count, Converter={StaticResource InverseVisibilityConverter}, ConverterParameter=invert}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Symbol="Block" Foreground="OrangeRed" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding Type}" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- No blockers state -->
            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"
                  Visibility="{Binding Blockers.Count, Converter={StaticResource InverseVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <SymbolIcon Symbol="Accept" Foreground="Green"/>
                    <TextBlock Text="No sleep blockers detected" Opacity="0.7" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Footer -->
        <StackPanel Grid.Row="6" Margin="24,12,24,24" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <Button Command="{Binding SmartSleepCommand}" Content="{StaticResource ButtonSmartSleep}" Style="{StaticResource AccentButtonStyle}" Width="160" Height="40" Background="#FF0078D7" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
        </StackPanel>
        
        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="7" Background="#88000000" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="64" Height="64" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
